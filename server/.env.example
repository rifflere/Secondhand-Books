PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=secondhand_books
JWT_SECRET=change_this_to_a_long_random_string

# URL of the app — used in password-reset email links
# Set this to http://<YOUR_EC2_IP> in production
APP_URL=http://localhost:5173

# Optional SMTP settings for sending real emails (account recovery / password reset)
# Without these, emails are printed to the server console instead of sent.
# Any SMTP provider works (Resend, Mailgun, SendGrid, Gmail, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Secondhand Books <noreply@yourdomain.com>
